# ========================================
# RENDER DEPLOYMENT - Environment Variables
# ========================================
# Copy this file to .env and fill in your values
# OR set these in Render Dashboard → Environment

# Database Configuration (Hostinger MySQL with remote access)
DB_HOST=72.60.202.163
DB_USER=crm_user
DB_PASSWORD=YOUR_PASSWORD_HERE
DB_NAME=crm_database
DB_PORT=3306

# Server Configuration
PORT=5001
NODE_ENV=production

# JWT Secret (Auto-generated by Render or use your own)
JWT_SECRET=2cb4a512d36045d37d2b1eaf955b0fcffb08edab8eedf9616aa5715adbb7d7c1

# Frontend URL (Will be your Render frontend URL)
FRONTEND_URL=https://crm-frontend.onrender.com

# ========================================
# IMPORTANT FOR RENDER DEPLOYMENT:
# ========================================
# 1. Enable remote MySQL access on Hostinger:
#    - cPanel → Remote MySQL
#    - Add IP: 0.0.0.0 (or Render's IP range)
#
# 2. Set environment variables in Render Dashboard:
#    - DB_PASSWORD (keep secret!)
#    - DB_USER
#    - DB_NAME
#    - FRONTEND_URL (update after frontend deployed)
#
# ========================================
